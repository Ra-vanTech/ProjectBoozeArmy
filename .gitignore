# ─── Godot 4 — Motor ─────────────────────────────────────────────────────────
.godot/
*.translation

# ─── Godot 4 — NO ignorar .uid ni .import ────────────────────────────────────
# Desde Godot 4.4 los archivos .gd.uid forman parte del proyecto y DEBEN
# versionarse. project.godot, .tscn y .tres referencian recursos por uid://; si
# los .uid se ignoran, cada máquina regenera un UID distinto al abrir el editor
# y esas referencias dejan de resolver (autoloads vacíos, scripts desasignados).
# Lo mismo aplica a los .import, que fijan el UID de cada asset importado.
# Solo la caché regenerable de .godot/ debe ignorarse.

# ─── Godot 4 — Exports y builds ──────────────────────────────────────────────
/export/
/build/
/dist/
*.apk
*.aab
*.ipa
*.exe
*.x86_64
*.pck

# ─── Android ─────────────────────────────────────────────────────────────────
/android/

# ─── Herramientas ────────────────────────────────────────────────────────────
__pycache__/

# ─── Editores ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── Sistema operativo ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Proyecto ────────────────────────────────────────────────────────────────
screenshots/